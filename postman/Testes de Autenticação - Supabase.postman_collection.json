      "name": "02 - Senha Login Incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login inválido retorna status 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Resposta informa credenciais inválidas\", function () {\r\n    const resposta = pm.response.json();\r\n    pm.expect(resposta.error_code).to.eql(\"invalid_credentials\");\r\n});"
            ]
          }
        }
      ],
