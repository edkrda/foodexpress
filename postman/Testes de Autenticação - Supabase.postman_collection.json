          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login válido retorna status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Resposta contém access_token\", function () {\r\n    const resposta = pm.response.json();\r\n    pm.expect(resposta.access_token).to.exist;\r\n});"
            ]
          }
        }
